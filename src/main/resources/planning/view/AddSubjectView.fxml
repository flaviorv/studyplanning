<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="planning.application.controller.AddSubjectController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label fx:id="title">Add Subject</Label>
    <TextField fx:id="subject" promptText="Subject" maxWidth="240"/>
    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="180">
        <Text>Start time:</Text>
        <TextField fx:id="startHours" promptText="HH" prefWidth="40" alignment="CENTER"/>
        <Text>:</Text>
        <TextField fx:id="startMinutes" promptText="mm" prefWidth="40" alignment="CENTER"/>
    </HBox>
    <Text fx:id="startTimeError" visible="false" managed="false" fill="red" layoutX="20"
          style="-fx-font-size: 0.9em; -fx-font-family: 'Verdana'; -fx-margin: 1px; -fx-padding: 1px">Invalid Data</Text>

    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="180">
        <Text>End time:</Text>
        <TextField fx:id="endHours" promptText="HH" prefWidth="40" alignment="CENTER"/>
        <Text>:</Text>
        <TextField fx:id="endMinutes" promptText="mm" prefWidth="40" alignment="CENTER"/>
    </HBox>
    <Text fx:id="endTimeError" visible="false" managed="false" fill="red" layoutX="20"
        style="-fx-font-size: 0.9em; -fx-font-family: 'Verdana'; -fx-margin: 1px; -fx-padding: 1px">Invalid Data</Text>

    <Button fx:id="confirmBtn" text="CONFIRM" onAction="#onAddSubjectBtnClick"/>
</VBox>
