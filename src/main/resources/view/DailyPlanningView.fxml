<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml" stylesheets="@../style/DailyPlanningStyle.css"
      fx:controller="planning.infrastructure.adapter.in.ui.javafx.DailyPlanningController">

    <FlowPane fx:id="days" hgap="10" vgap="10" alignment="CENTER" style="-fx-padding: 20 0 0 0"/>

    <HBox alignment="CENTER" spacing="8">
        <Label fx:id="planning" text="No planning for this day."/>
        <Button fx:id="addMoreButton" prefWidth="25" text="+" prefHeight="25" visible="false" managed="false" styleClass="options_button" onAction="#toAddSubjectView">
        </Button>
        <Button fx:id="configButton" prefWidth="25" prefHeight="25" visible="false" managed="false" styleClass="options_button" onAction="#toPlanningSettingsView">
            <graphic>
                <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                    <Image url="@../images/gear.png"/>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <Button fx:id="addButton" text="New" visible="false" managed="false" onAction="#toAddSubjectView"/>
    <TableView fx:id="subjects" visible="false">
        <columns>
            <TableColumn fx:id="subject" text="SUBJECT" />
            <TableColumn fx:id="startTime" text="START" />
            <TableColumn fx:id="endTime" text="END" />
            <TableColumn fx:id="done" text="IS DONE" />
        </columns>
    </TableView>
</VBox>
