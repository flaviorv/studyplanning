<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="planning.infrastructure.adapter.in.ui.javafx.AddSubjectController" stylesheets="@../style/AddSubjectStyle.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="50.0"/>
    </padding>
    <Label id="title" >ADD SUBJECT</Label>
    <TextField fx:id="subject" promptText="Subject" maxWidth="240"/>
    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="200">
        <Text styleClass="timeText">Start time:</Text>
        <TextField fx:id="startHours" promptText="HH" prefWidth="40" alignment="CENTER" />
        <Text>:</Text>
        <TextField fx:id="startMinutes" promptText="mm" prefWidth="40" alignment="CENTER" />
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="200">
        <Text styleClass="timeText">End time:</Text>
        <TextField fx:id="endHours" promptText="HH" prefWidth="40" alignment="CENTER"/>
        <Text>:</Text>
        <TextField fx:id="endMinutes" promptText="mm" prefWidth="40" alignment="CENTER"/>
    </HBox>
    <Button fx:id="confirmBtn" text="Confirm" onAction="#onAddSubjectBtnClick"/>
    <Text fx:id="errorText" text="Cannot add subject" visible="false" />
</VBox>
